    "is_active": true
  },
  {
    "domain": "psychology",
    "doc_key": "conflict-resolution",
    "title_zh": "冲突解决基本原则",
    "title_en": "Conflict Resolution",
    "content": "有效冲突解决原则：一次只谈一个问题、使用“我”句式表达感受、不翻旧账、轮流发言、区分事实与解读、以共同解决问题为目标而非争输赢、情绪过热时先暂停（约定暂停信号）再继续。",
    "keywords": ["冲突解决", "我句式", "暂停", "解决问题"],
    "meta": {"category": "conflict"},
    "orientation": null,
    "language": "zh",
    "source": "关系咨询通用原则（公开资料整理）",
